    {
      "name": "Store Settings",
      "description": "Endpoint HTTP real para configuracion de tienda. Requiere autenticacion NextAuth y membresia OWNER sobre storeId.",
      "item": [
        {
          "name": "PATCH Store Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Actualiza name, slug, description y whatsappPhone de la tienda autenticada. Sin sesion valida responde 401; sin membresia responde 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tienda Demo WALO\",\n  \"slug\": \"tienda-demo-walo\",\n  \"description\": \"Catalogo demo para pruebas Sprint 2\",\n  \"whatsappPhone\": \"+56912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/store/{{storeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "store",
                "{{storeId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE Store Deactivate",
          "request": {
            "method": "DELETE",
            "header": [],
